<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for this project. Paste it into the SignPath
  project's artifact configuration. Kept here so it is versioned with the build.
  The GitHub upload-artifact step delivers a ZIP whose root holds McScope.exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="McScope.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
